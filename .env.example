# ==============================================================================
# OpusCraft Environment Configuration
# ==============================================================================

# Supabase Credentials (Get from Supabase project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI API Key (For GPT-4o, DALL-E 3, Whisper, and Embeddings)
OPENAI_API_KEY=sk-proj-your-openai-key

# Dodo Payments Configuration (Get from https://app.dodopayments.com/developer/api-keys)
# Set to 'test_mode' for testing or 'live_mode' for production
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=5Rogsf8-Jfn6WXbn.05fYrq3cRORBeheTp5xV-TT__5RaSPdRefYCsG7Tlwv8cc-I
DODO_PAYMENTS_WEBHOOK_KEY=whsec_your_dodo_webhook_secret_here

# Dodo Payments Product IDs (Created in Dodo Payments Dashboard -> Products)
DODO_PRODUCT_CREATOR=pdt_your_creator_subscription_id
DODO_PRODUCT_AUTHORITY=pdt_your_authority_subscription_id
DODO_PRODUCT_TOPUP_50=pdt_your_topup_50_id
DODO_PRODUCT_TOPUP_150=pdt_your_topup_150_id

# App URL for Base Routing & Webhooks
NEXT_PUBLIC_APP_URL=http://localhost:3000

ADMIN_SECRET=your_admin_secret_key_here
