# ==============================================================================
# OpusCraft Environment Configuration (.env.example)
# Copy this file to .env.local and add your real keys. NEVER commit .env.local!
# ==============================================================================

# Supabase Credentials (Get from Supabase project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenAI API Key (For GPT-4o, DALL-E 3, Whisper, and Embeddings)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Dodo Payments Configuration (Get from https://app.dodopayments.com/developer/api-keys)
# Set to 'test_mode' for testing or 'live_mode' for production
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=your_dodo_payments_api_key_here
DODO_PAYMENTS_WEBHOOK_KEY=whsec_your_dodo_webhook_key_here

# Dodo Payments Product IDs (Created in Dodo Payments Dashboard -> Products)
DODO_PRODUCT_CREATOR=pdt_creator_plan_id
DODO_PRODUCT_AUTHORITY=pdt_authority_plan_id
DODO_PRODUCT_TOPUP_50=pdt_topup_50_id
DODO_PRODUCT_TOPUP_150=pdt_topup_150_id

# App URL for Base Routing & Webhooks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin / Webhook Secret
ADMIN_SECRET=your_admin_secret_key_here

# Google Analytics (GA4)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-C9JQFMLW24