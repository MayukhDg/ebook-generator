# ==============================================================================
# Foliocraft AI Environment Configuration
# ==============================================================================

# Supabase Credentials (Get from Supabase project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI API Key (For GPT-4o, DALL-E 3, Whisper, and Embeddings)
OPENAI_API_KEY=sk-proj-your-openai-key

# Polar Payments Configuration (Get from https://sandbox.polar.sh or https://polar.sh)
# Set to 'sandbox' for testing or 'production' for live payments
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=polar_at_your_access_token_here
POLAR_ORGANIZATION_ID=your_polar_org_id_here
POLAR_WEBHOOK_SECRET=your_polar_webhook_secret_here

# Polar Product IDs (UUIDs created in Polar Dashboard -> Products)
POLAR_PRODUCT_CREATOR=prod_your_creator_subscription_uuid
POLAR_PRODUCT_AUTHORITY=prod_your_authority_subscription_uuid
POLAR_PRODUCT_TOPUP_50=prod_your_topup_50_uuid
POLAR_PRODUCT_TOPUP_150=prod_your_topup_150_uuid

# App URL for Base Routing & Webhooks
NEXT_PUBLIC_APP_URL=http://localhost:3000

ADMIN_SECRET=your_admin_secret_key_here
